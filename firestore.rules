rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMember(hid) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    // Eigener Bereich jeder Person (Haushalts-Zuordnung, alter Speicherort).
    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Gemeinsamer Haushalt: Vorrat, Einkaufsliste, Statistik, Produktgedächtnis.
    match /households/{hid} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.resource.data.members == [request.auth.uid];
      // Mitglieder dürfen alles ändern. Wer den Code kennt, darf sich nur selbst hinzufügen.
      allow update: if signedIn() && (
        request.auth.uid in resource.data.members
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'emails'])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        )
      );
      allow delete: if false;

      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
